# PostgreSQL runtime account: least privilege; use a separate migration owner in production.
DATABASE_URL="postgresql://hotel:CHANGE_ME@localhost:5432/hotel?schema=public"
# Only database integration tests use this. Must be a dedicated disposable database.
TEST_DATABASE_URL=""
# Canonical origin for origin validation and absolute links.
APP_URL="http://localhost:3000"
# Local media directory; npm start resolves relative paths from the project root.
MEDIA_ROOT=".uploads"
# Generate at installation; no production default passwords or setup tokens.
SETUP_TOKEN=""
SESSION_SECRET=""
# Resend email delivery; configure a verified sender and run npm run worker.
EMAIL_API_KEY=""
EMAIL_FROM=""
# Reserved for future provider adapters; these do not enable integrations today.
# Provider secrets stay in environment/secret manager, never CMS exports.
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
EMAIL_PROVIDER=""
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
REDIS_URL=""
